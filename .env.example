# Render Web Service environment variables.
# Prefer linking a Render PostgreSQL database and importing its DATABASE_URL.
DATABASE_URL=<render-postgres-internal-connection-string>
DB_SSL=false

# Alternatively, remove DATABASE_URL and use these separate values:
DB_HOST=<render-postgres-internal-hostname>
DB_PORT=5432
DB_NAME=oes
DB_USER=oes_app
DB_PASSWORD=<render-postgres-app-password>

# Use two different long random values. For example:
#   openssl rand -hex 32
ANSWER_KEY_SECRET=<generate-a-long-random-secret>
RESULT_HMAC_SECRET=<generate-a-different-long-random-secret>

# Render serves the app over HTTPS.
COOKIE_SECURE=true
SEED_DEMO_DATA=true
SEED_DEMO_DATA=true
