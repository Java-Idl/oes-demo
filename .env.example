# Copy this file to .env and change every value before using it anywhere real.
POSTGRES_DB=oes
POSTGRES_USER=oes_owner
POSTGRES_PASSWORD=change-me-owner-password
APP_DB_USER=oes_app
APP_DB_PASSWORD=change-me-app-password

# Long random strings (e.g. `openssl rand -hex 32`)
ANSWER_KEY_SECRET=change-me-answer-key-secret-0123456789abcdef
RESULT_HMAC_SECRET=change-me-result-hmac-secret-0123456789abcdef

# true only when served over HTTPS
COOKIE_SECURE=false
SEED_DEMO_DATA=true
